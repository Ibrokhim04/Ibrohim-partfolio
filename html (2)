<title>Ibrohim Norjo‘rayev — Video Montajyor</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    background: #080808;
    color: white;
    font-family: Arial, sans-serif;
}

a {
    color: inherit;
    text-decoration: none;
}

.container {
    width: 90%;
    max-width: 1100px;
    margin: auto;
}

/* NAVBAR */

header {
    position: fixed;
    top: 0;
    width: 100%;
    background: rgba(8,8,8,0.85);
    backdrop-filter: blur(15px);
    z-index: 100;
    border-bottom: 1px solid #222;
}

nav {
    height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-weight: bold;
    letter-spacing: 2px;
}

.menu {
    display: flex;
    gap: 25px;
    font-size: 14px;
    color: #aaa;
}

/* HERO */

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
}

.small-title {
    color: #888;
    letter-spacing: 4px;
    font-size: 12px;
    margin-bottom: 25px;
}

h1 {
    font-size: clamp(50px, 10vw, 110px);
    line-height: 0.9;
    letter-spacing: -5px;
}

.outline {
    color: transparent;
    -webkit-text-stroke: 1px white;
}

.hero-text {
    max-width: 600px;
    color: #999;
    font-size: 18px;
    margin-top: 30px;
}

.buttons {
    display: flex;
    gap: 12px;
    margin-top: 30px;
}

.btn {
    padding: 14px 22px;
    border: 1px solid #444;
    border-radius: 50px;
}

.btn:hover {
    background: white;
    color: black;
}

.primary {
    background: white;
    color: black;
}

/* SECTIONS */

section {
    padding: 100px 0;
    border-top: 1px solid #222;
}

.title {
    font-size: clamp(40px, 6vw, 70px);
    margin-bottom: 40px;
}

/* PORTFOLIO */

.portfolio {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
}

.project {
    background: #111;
    border: 1px solid #222;
    border-radius: 15px;
    overflow: hidden;
}

.project video {
    width: 100%;
    display: block;
}

.project-info {
    padding: 20px;
}

.project-info h3 {
    margin-bottom: 5px;
}

.project-info p {
    color: #777;
}

/* ABOUT */

.about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 50px;
}

.about-text {
    color: #aaa;
    font-size: 18px;
    line-height: 1.8;
}

/* SERVICES */

.services {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 15px;
}

.service {
    padding: 30px;
    border: 1px solid #222;
    border-radius: 15px;
    background: #101010;
}

.service h3 {
    margin-bottom: 10px;
}

.service p {
    color: #777;
}

/* CONTACT */

.contact h2 {
    font-size: clamp(40px, 7vw, 80px);
    line-height: 1;
}

/* FOOTER */

footer {
    padding: 30px 0;
    color: #555;
}

/* PHONE */

@media(max-width:700px) {

    .menu {
        display: none;
    }

    .portfolio {
        grid-template-columns: 1fr;
    }

    .about {
        grid-template-columns: 1fr;
    }

    .services {
        grid-template-columns: 1fr;
    }

    h1 {
        letter-spacing: -3px;
    }

}
</style>
</head>

