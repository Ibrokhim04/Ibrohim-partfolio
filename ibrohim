/* ==========================================================
   TOKENS
   ========================================================== */
:root{
  --black:#0A0A0A;
  --charcoal:#131313;
  --charcoal-2:#1A1A1A;
  --line:#262626;
  --line-soft:#1D1D1D;
  --white:#F2F1EE;
  --gray:#8C8B86;
  --gray-dim:#54534E;
  --rec:#B23B34;

  --display:'Fraunces', serif;
  --body:'Inter', sans-serif;
  --mono:'JetBrains Mono', monospace;

  --container:1240px;
  --gutter:32px;
  --ease:cubic-bezier(0.22, 1, 0.36, 1);
}

@media(max-width:640px){
  :root{--gutter:20px;}
}

/* ==========================================================
   RESET
   ========================================================== */
*,*::before,*::after{box-sizing:border-box;}
html{scroll-behavior:smooth;}
@media (prefers-reduced-motion: reduce){
  html{scroll-behavior:auto;}
  *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
}
body{
  margin:0;
  background:var(--black);
  color:var(--white);
  font-family:var(--body);
  font-size:16px;
  line-height:1.6;
  -webkit-font-smoothing:antialiased;
}
img,video{max-width:100%;display:block;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;background:none;border:none;color:inherit;cursor:pointer;}
h1,h2,h3,p{margin:0;}
ul{list-style:none;margin:0;padding:0;}
::selection{background:var(--white);color:var(--black);}

.mono{font-family:var(--mono);}

a:focus-visible, button:focus-visible, video:focus-visible{
  outline:2px solid var(--white);
  outline-offset:4px;
}

.skip-link{
  position:absolute;
  left:-9999px;
  top:0;
  background:var(--white);
  color:var(--black);
  padding:12px 20px;
  z-index:1000;
  font-family:var(--mono);
  font-size:13px;
}
.skip-link:focus{left:16px; top:16px;}

/* ==========================================================
   LAYOUT HELPERS
   ========================================================== */
.section-inner{
  max-width:var(--container);
  margin:0 auto;
  padding:0 var(--gutter);
}
section{padding:140px 0;}
@media(max-width:820px){ section{padding:96px 0;} }

.eyebrow{
  font-family:var(--mono);
  font-size:12px;
  letter-spacing:0.12em;
  text-transform:uppercase;
  color:var(--gray);
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:20px;
}
.eyebrow::before{
  content:'';
  width:20px;height:1px;
  background:var(--gray-dim);
}

.section-title{
  font-family:var(--display);
  font-weight:400;
  font-size:clamp(38px, 5.4vw, 64px);
  letter-spacing:-0.01em;
  margin-bottom:56px;
}

.editable-placeholder{
  color:var(--gray-dim);
  font-style:italic;
}

/* reveal-on-scroll */
.reveal{
  opacity:0;
  transform:translateY(24px);
  transition:opacity 0.8s var(--ease), transform 0.8s var(--ease);
}
.reveal.is-visible{
  opacity:1;
  transform:translateY(0);
}

/* buttons */
.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:16px 32px;
  font-family:var(--body);
  font-size:14px;
  font-weight:500;
  letter-spacing:0.02em;
  border-radius:2px;
  transition:all 0.3s var(--ease);
  white-space:nowrap;
}
.btn-primary{
  background:var(--white);
  color:var(--black);
}
.btn-primary:hover{
  background:var(--gray);
  transform:translateY(-2px);
}
.btn-ghost{
  border:1px solid var(--line);
  color:var(--white);
}
.btn-ghost:hover{
  border-color:var(--white);
  transform:translateY(-2px);
}

/* placeholder badges (shared) */
.ph-badge{
  display:inline-block;
  font-size:10px;
  letter-spacing:0.1em;
  padding:5px 10px;
  border:1px solid var(--line);
  color:var(--gray);
  margin-bottom:12px;
}
.ph-hint{
  font-size:11px;
  color:var(--gray-dim);
  margin-top:4px;
}

/* ==========================================================
   HEADER / NAV
   ========================================================== */
.site-header{
  position:fixed;
  top:0; left:0; right:0;
  z-index:200;
  background:rgba(10,10,10,0.72);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line-soft);
}
.header-inner{
  max-width:var(--container);
  margin:0 auto;
  padding:0 var(--gutter);
  height:76px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.logo{
  font-family:var(--display);
  font-size:22px;
  letter-spacing:0.02em;
  display:flex;
  align-items:center;
  gap:8px;
}
.logo-dot{
  width:5px;height:5px;
  border-radius:50%;
  background:var(--rec);
}
.main-nav{
  display:flex;
  gap:40px;
}
.main-nav a{
  font-size:14px;
  color:var(--gray);
  position:relative;
  padding:4px 0;
  transition:color 0.3s;
}
.main-nav a:hover{color:var(--white);}
.main-nav a::after{
  content:'';
  position:absolute;
  left:0; bottom:0;
  width:0; height:1px;
  background:var(--white);
  transition:width 0.3s var(--ease);
}
.main-nav a:hover::after{width:100%;}

.rec-indicator{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:11px;
  color:var(--gray-dim);
  letter-spacing:0.05em;
}
.rec-dot{
  width:6px;height:6px;
  border-radius:50%;
  background:var(--rec);
  animation:recpulse 2s ease-in-out infinite;
}
@keyframes recpulse{
  0%,100%{opacity:1;}
  50%{opacity:0.25;}
}
@media(max-width:900px){ .rec-indicator{display:none;} }

.nav-toggle{
  display:none;
  flex-direction:column;
  gap:5px;
  padding:8px;
}
.nav-toggle span{
  width:22px;height:1px;
  background:var(--white);
  transition:all 0.3s var(--ease);
}
.nav-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(6px) rotate(45deg);}
.nav-toggle[aria-expanded="true"] span:nth-child(2){opacity:0;}
.nav-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-6px) rotate(-45deg);}

.mobile-nav{
  display:none;
  flex-direction:column;
  border-top:1px solid var(--line-soft);
  background:var(--black);
}
.mobile-nav.is-open{display:flex;}
.mobile-nav a{
  padding:18px var(--gutter);
  border-bottom:1px solid var(--line-soft);
  font-size:15px;
  color:var(--gray);
}
.mobile-nav a:hover{color:var(--white);}

@media(max-width:820px){
  .main-nav{display:none;}
  .nav-toggle{display:flex;}
}

/* ==========================================================
   HERO
   ========================================================== */
.hero{
  position:relative;
  min-height:100svh;
  display:flex;
  flex-direction:column;
  justify-content:center;
  padding:160px var(--gutter) 100px;
  overflow:hidden;
}

.hero-bar{
  position:absolute;
  left:0; right:0;
  height:64px;
  background:var(--black);
  border-color:var(--line-soft);
  z-index:2;
  transition:transform 1.1s var(--ease);
}
.hero-bar-top{top:0; border-bottom:1px solid var(--line-soft); transform:translateY(0);}
.hero-bar-bottom{bottom:0; border-top:1px solid var(--line-soft); transform:translateY(0);}
@media(max-width:640px){
  .hero-bar{height:36px;}
}

.hero-grain{
  position:absolute;
  inset:0;
  pointer-events:none;
  opacity:0.5;
  background-image:
    repeating-linear-gradient(0deg, rgba(255,255,255,0.015) 0px, rgba(255,255,255,0.015) 1px, transparent 1px, transparent 3px);
}

.hero-inner{
  position:relative;
  z-index:1;
  max-width:var(--container);
  margin:0 auto;
  width:100%;
}

.hero-name{
  font-family:var(--display);
  font-weight:400;
  font-size:clamp(52px, 10vw, 128px);
  line-height:0.98;
  letter-spacing:-0.015em;
  display:flex;
  flex-direction:column;
  margin-top:20px;
}

.hero-role{
  font-family:var(--mono);
  font-size:14px;
  letter-spacing:0.15em;
  text-transform:uppercase;
  color:var(--gray);
  margin-top:28px;
}

.hero-tagline{
  font-family:var(--display);
  font-style:italic;
  font-size:clamp(18px, 2.4vw, 26px);
  color:var(--gray);
  margin-top:10px;
  max-width:520px;
}

.hero-promise{
  font-family:var(--body);
  font-size:15px;
  color:var(--gray-dim);
  margin-top:14px;
  max-width:460px;
}

.hero-actions{
  margin-top:48px;
  display:flex;
  gap:16px;
  flex-wrap:wrap;
}

.hero-media{
  position:relative;
  z-index:1;
  max-width:var(--container);
  margin:64px auto 0;
  width:100%;
  aspect-ratio:21/9;
  background:var(--charcoal);
  border:1px solid var(--line);
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}
.hero-video{
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover;
}
.hero-media-placeholder{
  text-align:center;
  color:var(--gray);
  font-size:14px;
  padding:20px;
}
.hero-media-placeholder p{margin-top:2px;}

@media(max-width:640px){
  .hero-media{aspect-ratio:4/5; margin-top:48px;}
}

.scroll-indicator{
  position:absolute;
  bottom:28px; left:50%;
  transform:translateX(-50%);
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  z-index:2;
  color:var(--gray-dim);
  font-size:10px;
  letter-spacing:0.15em;
}
.scroll-line{
  width:1px; height:36px;
  background:linear-gradient(var(--gray), transparent);
  animation:scrollpulse 2s ease-in-out infinite;
}
@keyframes scrollpulse{
  0%,100%{opacity:0.3;}
  50%{opacity:1;}
}
@media(max-width:640px){ .scroll-indicator{display:none;} }

/* ==========================================================
   PORTFOLIO
   ========================================================== */
.filter-bar{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-bottom:48px;
}
.filter-btn{
  padding:10px 18px;
  border:1px solid var(--line);
  color:var(--gray);
  font-size:13px;
  letter-spacing:0.02em;
  border-radius:2px;
  transition:all 0.25s var(--ease);
}
.filter-btn:hover{color:var(--white); border-color:var(--gray);}
.filter-btn.is-active{
  background:var(--white);
  color:var(--black);
  border-color:var(--white);
}

.project-grid{
  display:grid;
  grid-template-columns:repeat(2, 1fr);
  gap:2px;
  background:var(--line);
  border:1px solid var(--line);
}
@media(max-width:820px){
  .project-grid{grid-template-columns:1fr;}
}

.project-card{
  background:var(--black);
  position:relative;
  display:flex;
  flex-direction:column;
  transition:background 0.3s;
}
.project-card:hover{background:var(--charcoal);}

.project-media{
  position:relative;
  aspect-ratio:16/9;
  background:var(--charcoal);
  overflow:hidden;
}
.project-media video{
  position:absolute;
  inset:0;
  width:100%; height:100%;
  object-fit:cover;
}
.project-media-placeholder{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  color:var(--gray);
  font-size:13px;
  padding:20px;
  border:1px dashed var(--line);
  margin:14px;
}

.play-btn{
  position:absolute;
  top:50%; left:50%;
  transform:translate(-50%,-50%) scale(0.9);
  width:56px; height:56px;
  border-radius:50%;
  border:1px solid rgba(242,241,238,0.4);
  background:rgba(10,10,10,0.5);
  display:flex;
  align-items:center;
  justify-content:center;
  opacity:0;
  transition:all 0.3s var(--ease);
}
.project-media:hover .play-btn, .play-btn:focus-visible{
  opacity:1;
  transform:translate(-50%,-50%) scale(1);
}
.play-btn::after{
  content:'';
  width:0;height:0;
  border-top:7px solid transparent;
  border-bottom:7px solid transparent;
  border-left:11px solid var(--white);
  margin-left:3px;
}
.project-card.no-video .play-btn{display:none;}

.project-body{
  padding:26px 28px 32px;
}
.project-cat{
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:0.08em;
  text-transform:uppercase;
  color:var(--gray-dim);
}
.project-title{
  font-family:var(--display);
  font-size:24px;
  margin-top:10px;
  font-weight:400;
}
.project-desc{
  font-size:14px;
  color:var(--gray);
  margin-top:8px;
  line-height:1.6;
}

/* ==========================================================
   ABOUT
   ========================================================== */
.about-grid{
  display:grid;
  grid-template-columns:0.85fr 1.15fr;
  gap:72px;
  align-items:start;
}
@media(max-width:820px){
  .about-grid{grid-template-columns:1fr;}
}

.photo-frame{
  aspect-ratio:4/5;
  background:var(--charcoal);
  border:1px solid var(--line);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  color:var(--gray);
  font-size:14px;
  padding:24px;
}

.about-text{
  font-size:18px;
  line-height:1.8;
  color:var(--gray);
  max-width:56ch;
}

.about-meta{
  margin-top:44px;
  border-top:1px solid var(--line-soft);
}
.about-meta-item{
  display:flex;
  gap:24px;
  padding:18px 0;
  border-bottom:1px solid var(--line-soft);
  font-size:14px;
  align-items:baseline;
  flex-wrap:wrap;
}
.about-meta-item .label{
  min-width:120px;
  color:var(--gray-dim);
  font-size:11px;
  letter-spacing:0.08em;
  text-transform:uppercase;
}

/* ==========================================================
   SKILLS
   ========================================================== */
.skills-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
  gap:1px;
  background:var(--line);
  border:1px solid var(--line);
}
.skill-card{
  background:var(--black);
  padding:34px 26px;
  transition:background 0.3s;
}
.skill-card:hover{background:var(--charcoal);}
.skill-card h3{
  font-family:var(--display);
  font-size:22px;
  font-weight:400;
}
.skill-card p{
  font-size:13.5px;
  color:var(--gray);
  margin-top:10px;
  line-height:1.7;
}

/* ==========================================================
   SERVICES
   ========================================================== */
.services-list{
  border-top:1px solid var(--line-soft);
}
.service-row{
  display:grid;
  grid-template-columns:60px 1fr 1.4fr;
  gap:32px;
  align-items:baseline;
  padding:32px 0;
  border-bottom:1px solid var(--line-soft);
  transition:padding-left 0.3s var(--ease);
}
.service-row:hover{padding-left:12px;}
.service-num{
  font-family:var(--mono);
  font-size:13px;
  color:var(--gray-dim);
}
.service-title{
  font-family:var(--display);
  font-size:clamp(22px, 2.6vw, 30px);
  font-weight:400;
}
.service-desc{
  font-size:14.5px;
  color:var(--gray);
  line-height:1.7;
}
@media(max-width:720px){
  .service-row{grid-template-columns:1fr; gap:8px;}
}

/* ==========================================================
   SHOWREEL
   ========================================================== */
.showreel-frame{
  position:relative;
  max-width:var(--container);
  margin:0 auto;
  padding:0 var(--gutter);
  aspect-ratio:16/9;
}
.showreel-video{
  position:absolute;
  inset:0 var(--gutter);
  width:calc(100% - var(--gutter) * 2);
  height:100%;
  background:var(--charcoal);
  border:1px solid var(--line);
}
.showreel-placeholder{
  position:absolute;
  inset:0 var(--gutter);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  color:var(--gray);
  font-size:14px;
  border:1px dashed var(--line);
  margin:0 var(--gutter);
  cursor:pointer;
  background:var(--charcoal);
  transition:border-color 0.3s;
}
.showreel-placeholder:hover{border-color:var(--gray);}

/* ==========================================================
   CONTACT
   ========================================================== */
.contact-inner{text-align:center;}
.contact-title{
  font-family:var(--display);
  font-weight:400;
  font-size:clamp(36px, 6vw, 68px);
  max-width:820px;
  margin:0 auto;
}
.contact-sub{
  font-family:var(--display);
  font-style:italic;
  font-size:clamp(18px, 2.4vw, 24px);
  color:var(--gray);
  margin-top:16px;
}
.contact-actions{
  margin-top:48px;
  display:flex;
  justify-content:center;
  gap:16px;
  flex-wrap:wrap;
}
.contact-note{
  margin-top:28px;
  font-size:11px;
  color:var(--gray-dim);
}

/* ==========================================================
   FOOTER
   ========================================================== */
.site-footer{
  border-top:1px solid var(--line-soft);
  padding-top:64px;
}
.footer-inner{
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:40px;
  padding-bottom:40px;
}
.footer-name{
  font-family:var(--display);
  font-size:20px;
}
.footer-role{
  font-size:11px;
  letter-spacing:0.1em;
  color:var(--gray-dim);
  margin-top:6px;
}
.footer-nav, .footer-social{
  display:flex;
  flex-direction:column;
  gap:10px;
  font-size:13px;
  color:var(--gray);
}
.footer-nav a:hover, .footer-social a:hover{color:var(--white);}

.footer-bottom{
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:8px;
  padding:24px 0 40px;
  border-top:1px solid var(--line-soft);
  font-size:11px;
  color:var(--gray-dim);
}

.needs-config{
  animation:shake 0.4s;
}
@keyframes shake{
  25%{transform:translateX(-4px);}
  75%{transform:translateX(4px);}
}

/* ==========================================================
   LIGHTBOX
   ========================================================== */
.lightbox{
  position:fixed;
  inset:0;
  z-index:500;
  background:rgba(6,6,6,0.94);
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40px var(--gutter);
}
.lightbox[hidden]{display:none;}
.lightbox-inner{
  width:100%;
  max-width:1100px;
  aspect-ratio:16/9;
  position:relative;
}
.lightbox-inner video{
  width:100%; height:100%;
  background:var(--black);
}
.lightbox-empty{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  text-align:center;
  color:var(--gray);
  border:1px dashed var(--line);
}
.lightbox-close{
  position:absolute;
  top:24px; right:28px;
  font-size:32px;
  line-height:1;
  color:var(--white);
}
